<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Colours are applied at runtime from Palette (theme + app colour); these are only the launch defaults. -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/maroon</item>
        <item name="android:colorPrimaryDark">@color/maroon_dark</item>
        <item name="android:colorAccent">@color/maroon</item>
        <item name="android:statusBarColor">@color/maroon_dark</item>
        <item name="android:windowBackground">@color/bg</item>
    </style>
    <style name="AppTheme.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/maroon</item>
        <item name="android:colorPrimaryDark">@color/maroon_dark</item>
        <item name="android:colorAccent">@color/gold</item>
        <item name="android:statusBarColor">@color/maroon_dark</item>
        <item name="android:windowBackground">@color/bg_dark</item>
    </style>
    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/card_bg</item>
        <item name="android:padding">14dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:elevation">2dp</item>
        <item name="android:tag">card</item>
    </style>
    <style name="BigButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:tag">btn</item>
    </style>
    <style name="MidButton" parent="BigButton">
        <item name="android:layout_height">46dp</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="SmallButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/btn_secondary</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:tag">btn2</item>
    </style>
    <style name="CardTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/maroon</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:tag">title</item>
    </style>
    <style name="Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:tag">text</item>
    </style>
    <style name="Soft" parent="Body">
        <item name="android:textColor">@color/text_soft</item>
        <item name="android:textSize">13sp</item>
        <item name="android:tag">soft</item>
    </style>
    <style name="Field">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textSize">14sp</item>
        <item name="android:tag">field</item>
    </style>
    <style name="Check">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text</item>
    </style>
    <style name="Radio">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:layout_marginRight">14dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text</item>
    </style>
    <style name="Page">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:fillViewport">true</item>
        <item name="android:visibility">gone</item>
    </style>
    <style name="PageBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingBottom">20dp</item>
    </style>
</resources>
